# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# Slack (Socket Mode)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_CHANNEL_ID=C...

# Discord
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# Time Messenger (set all three to select this integration)
TIME_BASE_URL=https://time.example.com
TIME_TOKEN=
TIME_CHANNEL_ID=

# Shared settings
SAAS_WS_URL=wss://api.srebot.site360.tech/api/v1/agent/connect
SAAS_AGENT_TOKEN=
REDIS_URL=redis://localhost:6379/0

# Follow-up admission
# Deprecated alias used as the per-user limit when FOLLOWUP_USER_MAX_TURNS is unset.
FOLLOWUP_MAX_TURNS=5
# Optional per-user, per-incident limit. Empty values are ignored; when set, this overrides
# FOLLOWUP_MAX_TURNS.
FOLLOWUP_USER_MAX_TURNS=
# Total accepted follow-ups across all users in one incident.
FOLLOWUP_INCIDENT_MAX_TURNS=20
FOLLOWUP_TTL=43200

# Analysis concurrency (process-wide admission limits)
# Max simultaneous analyses (alert, general query, follow-up) in this process.
ANALYSIS_MAX_CONCURRENCY=20
# Max simultaneous analyses for one platform/chat/user; others wait FIFO.
ANALYSIS_MAX_CONCURRENCY_PER_USER=3

LOG_LEVEL=INFO
DRY_RUN=false
# Optional outbound HTTP proxy for all chat integrations (including HTTPS/WSS).
# Docker Compose exports this file; for local runs export variables in the shell.
# HTTPS_PROXY=http://proxy.example.com:3128
# Proxy authentication: http://user:password@proxy.example.com:3128
